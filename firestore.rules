rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Workspaces: authenticated users can read/write their own workspaces.
    // For a public demo, allow all reads and authenticated writes.
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /prompts/{promptId} {
        allow read: if true;
        allow write: if request.auth != null;

        match /versions/{versionId} {
          allow read: if true;
          allow write: if request.auth != null;
        }

        match /metrics/{metricId} {
          allow read: if true;
          allow write: if request.auth != null;
        }
      }
    }
  }
}
